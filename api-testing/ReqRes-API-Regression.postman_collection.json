  "item": [
    {
      "name": "GET List Users - Page 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test 1: Verify 200 OK status code\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// Test 2: Verify response returns an array of users\r\npm.test(\"Response returns user list array\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.be.an('array');\r\n    pm.expect(jsonData.length).to.be.above(0);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST Create User. Set HTTP dropdown to POST",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test 1: Verify 201 Created status\npm.test(\"Status code is 201 Created\", function () {\n    pm.response.to.have.status(201);\n});\n\n// Test 2: Verify response contains generated ID and correct title\npm.test(\"Resource created with correct title and generated ID\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.title).to.eql(\"QA Analyst\");\n    pm.expect(jsonData).to.have.property(\"id\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"QA Analyst\",\r\n  \"body\": \"Tester\",\r\n  \"userId\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST Login - Missing Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test 1: Verify 400 Bad Request status code\r\npm.test(\"Status code is 400 Bad Request\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\n// Test 2: Validate error message in JSON response\r\npm.test(\"Error message indicates missing password\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.message).to.be.a(\"string\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"kminchelle\"\r\n}",
          "options": {
